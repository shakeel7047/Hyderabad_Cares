{
  "id": "./",
  "name": "FixMyHyderabad",
  "short_name": "FixMyHyd",
  "description": "Report and track civic issues in Hyderabad, Sindh — roads, streetlights, water, drainage, garbage and more.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#faf6ee",
  "theme_color": "#0f4c52",
  "categories": ["government", "utilities", "social"],
  "icons": [
    {
      "src": "assets/app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Report an issue",
      "short_name": "Report",
      "description": "Open the report form",
      "url": "./report.html",
      "icons": [
        {
          "src": "assets/app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live map",
      "short_name": "Map",
      "description": "See reports across Hyderabad",
      "url": "./map.html",
      "icons": [
        {
          "src": "assets/app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
